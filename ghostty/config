# --- Font: 小さめ・長文の読みやすさ重視 ---
font-family = Moralerspace Xenon HW
font-size = 14
# WQHD では細く見えるのでオン (11pt のときは滲んだのでオフにしていた)
font-thicken = true
# 行間を広げて長文を追いやすく
adjust-cell-height = 8%
# リガチャ無効 (->, != などを素直に表示)
font-feature = -calt

# --- Theme: 低グレアで目が疲れにくい暗色 ---
theme = Catppuccin Mocha
# 暗すぎる文字色を WCAG AA (4.5) まで自動で持ち上げる
minimum-contrast = 4.5
# 本文をテーマ標準よりやや白寄りにして可読性を上げる
foreground = #e3e8ff

# --- Window ---
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
